LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google Drive 備份（選填；沒設定就停用備份功能）
# OAuth 用戶端（Desktop app 類型）的 JSON 檔路徑，從 Google Cloud Console 下載
# 只有本機執行 google_auth_setup.py 一次性授權時需要，雲端部署不用設定這個
GOOGLE_OAUTH_CLIENT_FILE=./google-oauth-client.json
# 執行 google_auth_setup.py 後產生的授權 token 檔路徑（本機開發用）
GOOGLE_OAUTH_TOKEN_FILE=./google-token.json
# 雲端部署（如 Render）用：把 google-token.json 的完整內容貼在這裡當環境變數，
# 設定了這個就會優先使用，不需要 GOOGLE_OAUTH_TOKEN_FILE
GOOGLE_OAUTH_TOKEN_JSON=
# 備份目的地資料夾的 ID（Drive 資料夾網址中 /folders/ 後面那一串）
GOOGLE_DRIVE_FOLDER_ID=
